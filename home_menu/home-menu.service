[Unit]
Description=Home menu — project index page
After=network-online.target
Wants=network-online.target
# Give up instead of hammering a restart loop if startup keeps failing
# (e.g. a syntax error shipped in server.py) — 5 starts / 5 min, then stop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=simon
WorkingDirectory=/home/simon/projects/home_menu
ExecStart=/usr/bin/python3 /home/simon/projects/home_menu/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
