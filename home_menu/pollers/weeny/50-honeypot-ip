#!/bin/bash
# weeny -- NetworkManager dispatcher: keep the bait IP 192.168.1.5 on wlan0
# whenever wlan0 is on the home LAN.
#
# Deploy: sudo install -m0755 50-honeypot-ip \
#             /etc/NetworkManager/dispatcher.d/50-honeypot-ip
#
# The address is also set on the connection profile (`nmcli con mod ...
# +ipv4.addresses 192.168.1.5/32`), but comitup can replace that profile when a
# phone re-provisions Wi-Fi at a new site -- a comitup-made profile won't carry
# the alias. This script re-adds it on every relevant NM event so it survives
# that.
#
# NetworkManager calls this as:  <script> <interface> <action>
# For `connectivity-change` the interface arg is EMPTY, so we key off the action
# and inspect wlan0 directly.

action="$2"
case "$action" in
    up|dhcp4-change|connectivity-change) ;;
    *) exit 0 ;;
esac

# Only when wlan0 actually has a home-LAN address (skip hotspot mode, where
# comitup puts its own 10.41.0.1/24 on wlan0, and skip "down").
ip -4 addr show dev wlan0 2>/dev/null | grep -q ' inet 192\.168\.1\.' || exit 0

# Already there? nothing to do.
ip -4 addr show dev wlan0 | grep -q ' inet 192\.168\.1\.5/' && exit 0

if ip addr add 192.168.1.5/32 dev wlan0 2>/dev/null; then
    logger -t honeypot-ip "added 192.168.1.5/32 to wlan0 ($action)"
fi
exit 0
