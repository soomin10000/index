# weeny -- provisioning secrets. NOT tracked in git (see repo .gitignore).
#
# Copy this to `secrets.env`, fill it in, and place it on the boot partition
# next to provision.sh:  /Volumes/bootfs/weeny/secrets.env
# provision.sh reads it at stage 12; the values never touch the repo.

# WPA2 pre-shared key for comitup's re-provisioning hotspot (8-63 chars).
# REQUIRED -- provision.sh fails stage 12 with a clear message if this is unset.
COMITUP_AP_PASSWORD=

# Optional overrides (defaults shown):
# WEENY_NTFY_URL=http://192.168.1.183:8197
# WEENY_NTFY_TOPIC=steve_updates
